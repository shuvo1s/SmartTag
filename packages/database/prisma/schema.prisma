// SmartTag Platform — relational model
//
// Conventions
// - UUIDv7 primary keys (time-ordered, index-friendly), snake_case tables/columns.
// - Every tenant-owned table carries organization_id. Relations between tenant-owned rows use
//   COMPOSITE foreign keys that include organization_id, so the database itself makes it
//   impossible to link, e.g., a template to another tenant's customer.
// - CHECK constraints and triggers that Prisma cannot express live in hand-written migrations
//   (see prisma/migrations/*_integrity_constraints).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------------------------
// Identity & tenancy
// ------------------------------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  TEMPLATE_ADMIN
  DESIGNER
  DATA_OPERATOR
  QA
  APPROVER
  PRODUCTION_OPERATOR
  PRODUCTION_MANAGER
  VIEWER

  @@map("role")
}

enum IdentityProviderType {
  OIDC

  @@map("identity_provider_type")
}

model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  slug      String             @unique @db.VarChar(64)
  name      String             @db.VarChar(200)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships             Membership[]
  sessions                Session[]
  customers               Customer[]
  brands                  Brand[]
  templates               Template[]
  templateVersions        TemplateVersion[]
  assets                  Asset[]
  fontFaces               FontFace[]
  auditEvents             AuditEvent[]
  dataSourceFiles         DataSourceFile[]
  dataImports             DataImport[]
  datasets                Dataset[]
  datasetVersions         DatasetVersion[]
  datasetRecords          DatasetRecord[]
  mappingProfiles         MappingProfile[]
  mappingProfileRevisions MappingProfileRevision[]
  sequences               Sequence[]
  sequenceReservations    SequenceReservation[]
  productionJobs          ProductionJob[]
  productionJobCounters   ProductionJobCounter[]
  productionInstances     ProductionInstance[]
  productionArtifacts     ProductionArtifact[]
  productionJobEvents     ProductionJobEvent[]

  @@map("organizations")
}

/// A person. Users are global; access to tenants is granted through memberships.
model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case (enforced by CHECK constraint).
  email       String     @unique @db.VarChar(320)
  displayName String     @map("display_name") @db.VarChar(200)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential PasswordCredential?
  externalIdentities ExternalIdentity[]
  memberships        Membership[]
  sessions           Session[]

  createdCustomers               Customer[]               @relation("CustomerCreatedBy")
  createdBrands                  Brand[]                  @relation("BrandCreatedBy")
  createdTemplates               Template[]               @relation("TemplateCreatedBy")
  updatedTemplates               Template[]               @relation("TemplateUpdatedBy")
  createdTemplateVersions        TemplateVersion[]        @relation("TemplateVersionCreatedBy")
  submittedVersions              TemplateVersion[]        @relation("TemplateVersionSubmittedBy")
  approvedVersions               TemplateVersion[]        @relation("TemplateVersionApprovedBy")
  retiredVersions                TemplateVersion[]        @relation("TemplateVersionRetiredBy")
  createdAssets                  Asset[]                  @relation("AssetCreatedBy")
  auditEvents                    AuditEvent[]
  createdDataSourceFiles         DataSourceFile[]         @relation("DataSourceFileCreatedBy")
  createdDataImports             DataImport[]             @relation("DataImportCreatedBy")
  createdDatasets                Dataset[]                @relation("DatasetCreatedBy")
  updatedDatasets                Dataset[]                @relation("DatasetUpdatedBy")
  createdDatasetVersions         DatasetVersion[]         @relation("DatasetVersionCreatedBy")
  finalizedDatasetVersions       DatasetVersion[]         @relation("DatasetVersionFinalizedBy")
  createdMappingProfiles         MappingProfile[]         @relation("MappingProfileCreatedBy")
  createdSequences               Sequence[]               @relation("SequenceCreatedBy")
  updatedSequences               Sequence[]               @relation("SequenceUpdatedBy")
  reservedSequenceRanges         SequenceReservation[]    @relation("SequenceReservationReservedBy")
  createdProductionJobs          ProductionJob[]          @relation("ProductionJobCreatedBy")
  releasedProductionJobs         ProductionJob[]          @relation("ProductionJobReleasedBy")
  cancelledProductionJobs        ProductionJob[]          @relation("ProductionJobCancelledBy")
  acknowledgedProductionJobs     ProductionJob[]          @relation("ProductionJobWarningsAcknowledgedBy")
  createdProductionArtifacts     ProductionArtifact[]     @relation("ProductionArtifactCreatedBy")
  createdProductionJobEvents     ProductionJobEvent[]     @relation("ProductionJobEventCreatedBy")
  updatedMappingProfiles         MappingProfile[]         @relation("MappingProfileUpdatedBy")
  createdMappingProfileRevisions MappingProfileRevision[] @relation("MappingProfileRevisionCreatedBy")

  @@map("users")
}

/// Local username/password credential. Hash is an encoded Argon2id string (includes salt and parameters).
model PasswordCredential {
  userId            String   @id @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

/// Link to an external identity provider account (e.g. Microsoft Entra ID via OIDC).
/// (issuer, subject) uniquely identifies the external account. Not used for login in Phase 1.
model ExternalIdentity {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  providerType IdentityProviderType @map("provider_type")
  issuer       String               @db.VarChar(500)
  subject      String               @db.VarChar(255)
  email        String?              @db.VarChar(320)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime?            @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("external_identities")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, role])
  @@map("membership_roles")
}

/// Server-side session. Only the SHA-256 hash of the opaque session token is stored.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  tokenHash            String    @unique @map("token_hash") @db.Char(64)
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String    @map("active_organization_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  userAgent            String?   @map("user_agent") @db.VarChar(500)

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization @relation(fields: [activeOrganizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------------------------------------------------------------
// Customers & brands
// ------------------------------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED

  @@map("record_status")
}

model Customer {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User            @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  brands         Brand[]
  templates      Template[]
  datasets       Dataset[]
  productionJobs ProductionJob[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("customers")
}

model Brand {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite FK: a brand can only belong to a customer of the same organization.
  customer       Customer        @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User            @relation("BrandCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  templates      Template[]
  productionJobs ProductionJob[]

  @@unique([customerId, code])
  @@unique([id, customerId, organizationId])
  @@index([organizationId])
  @@map("brands")
}

// ------------------------------------------------------------------------------------------------
// Templates & immutable versions
// ------------------------------------------------------------------------------------------------

enum DocumentType {
  HANG_TAG
  CARE_LABEL
  PRICE_TICKET
  BARCODE_LABEL
  SIZE_STICKER
  RFID_LABEL
  PACKAGING_LABEL
  CARTON_LABEL
  SHIPPING_LABEL
  HEAT_TRANSFER
  POLYBAG_LABEL

  @@map("document_type")
}

enum TemplateStatus {
  ACTIVE
  ARCHIVED

  @@map("template_status")
}

enum TemplateVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RETIRED

  @@map("template_version_status")
}

/// The long-lived logical design (e.g. "Brand X basic hang tag").
model Template {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  customerId          String?        @map("customer_id") @db.Uuid
  brandId             String?        @map("brand_id") @db.Uuid
  /// Stable integration identifier. Unique per organization, immutable after creation.
  code                String         @db.VarChar(64)
  name                String         @db.VarChar(200)
  description         String         @default("") @db.VarChar(2000)
  documentType        DocumentType   @map("document_type")
  status              TemplateStatus @default(ACTIVE)
  /// Head version: the most recently created version. Production jobs never use this pointer —
  /// they reference an explicit TemplateVersion id.
  currentVersionId    String?        @unique @map("current_version_id") @db.Uuid
  /// Monotonic counter used to allocate version numbers under a row lock.
  latestVersionNumber Int            @default(0) @map("latest_version_number")
  createdById         String         @map("created_by_id") @db.Uuid
  updatedById         String         @map("updated_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer?         @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  brand          Brand?            @relation(fields: [brandId, customerId, organizationId], references: [id, customerId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  /// Composite FK: the current version must belong to this template.
  currentVersion TemplateVersion?  @relation("TemplateCurrentVersion", fields: [currentVersionId, id], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict)
  versions       TemplateVersion[] @relation("TemplateVersions")
  productionJobs ProductionJob[]
  createdBy      User              @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User              @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@unique([currentVersionId, id])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, customerId])
  @@map("templates")
}

/// Immutable artwork at a specific revision. Only DRAFT versions may change content;
/// a database trigger enforces this independently of application code.
model TemplateVersion {
  id               String                @id @default(uuid(7)) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  templateId       String                @map("template_id") @db.Uuid
  versionNumber    Int                   @map("version_number")
  schemaVersion    Int                   @map("schema_version")
  /// Canonical DesignDocument JSON exactly as validated.
  documentJson     Json                  @map("document_json")
  /// SHA-256 (hex) of the RFC 8785 canonical JSON of documentJson.
  documentHash     String                @map("document_hash") @db.Char(64)
  /// Derived, render-free summary for listings (recomputed whenever documentJson changes).
  summaryJson      Json                  @map("summary_json")
  status           TemplateVersionStatus @default(DRAFT)
  changeSummary    String                @default("") @map("change_summary") @db.VarChar(1000)
  basedOnVersionId String?               @map("based_on_version_id") @db.Uuid
  /// Optimistic-concurrency counter for draft edits.
  revision         Int                   @default(1)
  createdById      String                @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedById    String?               @map("submitted_by_id") @db.Uuid
  submittedAt      DateTime?             @map("submitted_at") @db.Timestamptz(3)
  approvedById     String?               @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?             @map("approved_at") @db.Timestamptz(3)
  retiredById      String?               @map("retired_by_id") @db.Uuid
  retiredAt        DateTime?             @map("retired_at") @db.Timestamptz(3)

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template           Template          @relation("TemplateVersions", fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  currentForTemplate Template?         @relation("TemplateCurrentVersion")
  /// Lineage stays within the same template.
  basedOn            TemplateVersion?  @relation("VersionLineage", fields: [basedOnVersionId, templateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict)
  derivedVersions    TemplateVersion[] @relation("VersionLineage")
  createdBy          User              @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy        User?             @relation("TemplateVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy         User?             @relation("TemplateVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  retiredBy          User?             @relation("TemplateVersionRetiredBy", fields: [retiredById], references: [id], onDelete: Restrict)
  dataImports        DataImport[]
  datasetVersions    DatasetVersion[]
  productionJobs     ProductionJob[]

  @@unique([templateId, versionNumber])
  @@unique([id, templateId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([documentHash])
  @@map("template_versions")
}

// ------------------------------------------------------------------------------------------------
// Assets
// ------------------------------------------------------------------------------------------------

enum AssetType {
  LOGO
  IMAGE
  SVG
  FONT
  ICON
  CARE_SYMBOL
  CERTIFICATION_SYMBOL

  @@map("asset_type")
}

/// Metadata for a stored binary. The bytes live in object storage under `storageKey`;
/// records never reference a storage vendor, bucket or URL directly.
model Asset {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  assetType      AssetType @map("asset_type")
  filename       String    @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(127)
  sizeBytes      Int       @map("size_bytes")
  storageKey     String    @map("storage_key") @db.VarChar(512)
  checksumSha256 String    @map("checksum_sha256") @db.Char(64)
  widthPx        Int?      @map("width_px")
  heightPx       Int?      @map("height_px")
  metadata       Json      @default("{}")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  fontFace     FontFace?

  @@unique([id, organizationId])
  @@index([organizationId, assetType, createdAt])
  @@index([organizationId, checksumSha256])
  @@map("assets")
}

enum FontStyle {
  NORMAL
  ITALIC

  @@map("font_style")
}

enum FontFormat {
  TTF
  OTF
  WOFF
  WOFF2

  @@map("font_format")
}

enum FontEmbeddingPermission {
  INSTALLABLE
  EDITABLE
  PREVIEW_AND_PRINT
  RESTRICTED

  @@map("font_embedding_permission")
}

/// Font registry. One immutable row per FONT asset; every value is read from the font file itself.
/// Text objects reference the asset id, so the exact file (and therefore glyphs and metrics) is pinned.
model FontFace {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  assetId             String                  @unique @map("asset_id") @db.Uuid
  familyName          String                  @map("family_name") @db.VarChar(200)
  subfamilyName       String                  @map("subfamily_name") @db.VarChar(200)
  fullName            String                  @map("full_name") @db.VarChar(300)
  postscriptName      String                  @map("postscript_name") @db.VarChar(127)
  fontVersion         String                  @map("font_version") @db.VarChar(100)
  /// CSS weight 100–900 derived from OS/2 usWeightClass.
  weight              Int
  style               FontStyle
  format              FontFormat
  embeddingPermission FontEmbeddingPermission @map("embedding_permission")
  unitsPerEm          Int                     @map("units_per_em")
  ascender            Int
  descender           Int
  lineGap             Int                     @map("line_gap")
  capHeight           Int?                    @map("cap_height")
  xHeight             Int?                    @map("x_height")
  glyphCount          Int                     @map("glyph_count")
  /// Sorted inclusive code point ranges: [[first, last], ...]
  unicodeRanges       Json                    @map("unicode_ranges")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assetId, organizationId])
  @@index([organizationId, familyName, weight, style])
  @@map("font_faces")
}

// ------------------------------------------------------------------------------------------------
// Data imports, datasets and mapping profiles (Phase 4)
//
// DataImport       one upload being inspected, mapped and validated (a working session)
// DataSourceFile   the original uploaded bytes (object storage), kept unchanged for audit
// Dataset          a long-lived logical data collection
// DatasetVersion   the output of one validation run: DRAFT while an import is reviewed, then
//                  FINALIZED (numbered, hashed, immutable). A revised upload creates a new version.
// DatasetRecord    one normalized row of a dataset version, identified by (version, sequence)
// MappingProfile   a reusable mapping; every change creates an immutable MappingProfileRevision
// ------------------------------------------------------------------------------------------------

enum DataSourceFormat {
  CSV
  XLSX

  @@map("data_source_format")
}

enum DataSourceFileStatus {
  /// Row created, bytes not yet confirmed in storage (cleanup removes stale pending uploads).
  PENDING
  STORED
  /// Bytes removed from storage (abandoned import); the metadata stays for audit.
  DELETED

  @@map("data_source_file_status")
}

enum DataImportStatus {
  UPLOADED
  INSPECTING
  MAPPING_REQUIRED
  READY_TO_VALIDATE
  VALIDATING
  READY
  READY_WITH_WARNINGS
  HAS_ERRORS
  FAILED
  CANCELLED
  FINALIZED

  @@map("data_import_status")
}

enum DatasetVersionStatus {
  DRAFT
  FINALIZED

  @@map("dataset_version_status")
}

enum DatasetRecordStatus {
  VALID
  WARNING
  ERROR

  @@map("dataset_record_status")
}

enum MappingProfileStatus {
  ACTIVE
  ARCHIVED

  @@map("mapping_profile_status")
}

/// An uploaded CSV/XLSX file. Bytes live in object storage under storageKey; never modified.
model DataSourceFile {
  id               String               @id @default(uuid(7)) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  status           DataSourceFileStatus @default(PENDING)
  storageKey       String               @map("storage_key") @db.VarChar(512)
  originalFilename String               @map("original_filename") @db.VarChar(255)
  /// Format detected from the content (never from the browser's MIME type).
  format           DataSourceFormat
  /// The MIME type the browser sent, kept for diagnostics only.
  declaredMimeType String?              @map("declared_mime_type") @db.VarChar(127)
  sizeBytes        Int                  @map("size_bytes")
  checksumSha256   String               @map("checksum_sha256") @db.Char(64)
  createdById      String               @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  storedAt         DateTime?            @map("stored_at") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User             @relation("DataSourceFileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  imports         DataImport[]
  datasetVersions DatasetVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("data_source_files")
}

/// One import of one source file into one exact template version.
model DataImport {
  id                     String           @id @default(uuid(7)) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  templateVersionId      String           @map("template_version_id") @db.Uuid
  /// The template version's document hash when the import was created; validation and
  /// finalization refuse to continue if the version changed since.
  templateVersionHash    String           @map("template_version_hash") @db.Char(64)
  dataSchemaHash         String           @map("data_schema_hash") @db.Char(64)
  /// Existing dataset chosen as the target when the import started (optional).
  targetDatasetId        String?          @map("target_dataset_id") @db.Uuid
  sourceFileId           String           @map("source_file_id") @db.Uuid
  status                 DataImportStatus @default(UPLOADED)
  /// Optimistic-concurrency counter for user actions (settings, mapping, validate, finalize, cancel).
  revision               Int              @default(1)
  sourceSettings         Json             @map("source_settings")
  inspection             Json?
  columns                Json             @default("[]")
  mapping                Json?
  mappingProfileId       String?          @map("mapping_profile_id") @db.Uuid
  mappingProfileRevision Int?             @map("mapping_profile_revision")
  /// Incremented whenever inspection or validation is (re)requested; jobs carry the run they belong to.
  inspectionRun          Int              @default(0) @map("inspection_run")
  validationRun          Int              @default(0) @map("validation_run")
  progressProcessedRows  Int              @default(0) @map("progress_processed_rows")
  progressTotalRows      Int?             @map("progress_total_rows")
  progressUpdatedAt      DateTime?        @map("progress_updated_at") @db.Timestamptz(3)
  failure                Json?
  /// Parser and normalization versions, job metrics.
  processing             Json             @default("{}")
  createdById            String           @map("created_by_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  validatedAt            DateTime?        @map("validated_at") @db.Timestamptz(3)
  finalizedAt            DateTime?        @map("finalized_at") @db.Timestamptz(3)
  cancelledAt            DateTime?        @map("cancelled_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  templateVersion TemplateVersion  @relation(fields: [templateVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  targetDataset   Dataset?         @relation(fields: [targetDatasetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  sourceFile      DataSourceFile   @relation(fields: [sourceFileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  mappingProfile  MappingProfile?  @relation(fields: [mappingProfileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User             @relation("DataImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  datasetVersions DatasetVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, createdAt])
  @@index([status, updatedAt])
  @@map("data_imports")
}

model Dataset {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  name                String   @db.VarChar(200)
  description         String   @default("") @db.VarChar(2000)
  customerId          String?  @map("customer_id") @db.Uuid
  /// Monotonic counter used to allocate version numbers under a row lock.
  latestVersionNumber Int      @default(0) @map("latest_version_number")
  createdById         String   @map("created_by_id") @db.Uuid
  updatedById         String   @map("updated_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer       Customer?        @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy      User             @relation("DatasetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User             @relation("DatasetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions       DatasetVersion[]
  imports        DataImport[]
  productionJobs ProductionJob[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@map("datasets")
}

/// The output of one validation run of an import. DRAFT versions are rebuilt by revalidation;
/// FINALIZED versions are numbered, hashed and immutable (enforced by triggers).
model DatasetVersion {
  id                     String               @id @default(uuid(7)) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  /// Null while DRAFT; set when finalized.
  datasetId              String?              @map("dataset_id") @db.Uuid
  versionNumber          Int?                 @map("version_number")
  status                 DatasetVersionStatus @default(DRAFT)
  importId               String               @map("import_id") @db.Uuid
  validationRun          Int                  @map("validation_run")
  templateVersionId      String               @map("template_version_id") @db.Uuid
  templateVersionHash    String               @map("template_version_hash") @db.Char(64)
  dataSchemaHash         String               @map("data_schema_hash") @db.Char(64)
  sourceFileId           String               @map("source_file_id") @db.Uuid
  sourceChecksumSha256   String               @map("source_checksum_sha256") @db.Char(64)
  /// Canonical mapping (entries sorted by field, parsing rules) used to produce the records.
  mappingSnapshot        Json                 @map("mapping_snapshot")
  /// Source settings, columns, limits and parser/normalization versions.
  importConfiguration    Json                 @map("import_configuration")
  mappingProfileId       String?              @map("mapping_profile_id") @db.Uuid
  mappingProfileRevision Int?                 @map("mapping_profile_revision")
  rowCount               Int                  @default(0) @map("row_count")
  validCount             Int                  @default(0) @map("valid_count")
  warningCount           Int                  @default(0) @map("warning_count")
  errorCount             Int                  @default(0) @map("error_count")
  blankRowCount          Int                  @default(0) @map("blank_row_count")
  duplicateRowCount      Int                  @default(0) @map("duplicate_row_count")
  /// SHA-256 over the ordered record hashes; set when the validation run completed.
  recordsDigest          String?              @map("records_digest") @db.Char(64)
  datasetHash            String?              @map("dataset_hash") @db.Char(64)
  validationSummary      Json                 @default("{}") @map("validation_summary")
  /// Set when every row was written (a DRAFT without it is an interrupted run).
  completedAt            DateTime?            @map("completed_at") @db.Timestamptz(3)
  warningsAcknowledgedAt DateTime?            @map("warnings_acknowledged_at") @db.Timestamptz(3)
  createdById            String               @map("created_by_id") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedById          String?              @map("finalized_by_id") @db.Uuid
  finalizedAt            DateTime?            @map("finalized_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dataset         Dataset?        @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  import          DataImport      @relation(fields: [importId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  templateVersion TemplateVersion @relation(fields: [templateVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  sourceFile      DataSourceFile  @relation(fields: [sourceFileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User            @relation("DatasetVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedBy     User?           @relation("DatasetVersionFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  records         DatasetRecord[]
  productionJobs  ProductionJob[]

  @@unique([importId, validationRun])
  @@unique([datasetId, versionNumber])
  @@unique([id, organizationId])
  @@index([organizationId, status, finalizedAt])
  @@map("dataset_versions")
}

/// One normalized row. Identity is (datasetVersionId, sequence); sequence follows source order.
model DatasetRecord {
  datasetVersionId    String              @map("dataset_version_id") @db.Uuid
  sequence            Int
  organizationId      String              @map("organization_id") @db.Uuid
  /// Row number in the source (spreadsheet row or CSV record index).
  rowNumber           Int                 @map("row_number")
  status              DatasetRecordStatus
  normalizedRecord    Json                @map("normalized_record")
  recordHash          String              @map("record_hash") @db.Char(64)
  /// Null for rows with errors.
  resolvedInputHash   String?             @map("resolved_input_hash") @db.Char(64)
  errorCount          Int                 @map("error_count")
  warningCount        Int                 @map("warning_count")
  issues              Json                @default("[]")
  /// Sequence of the first record with the same record hash (duplicates are kept, never removed).
  duplicateOfSequence Int?                @map("duplicate_of_sequence")
  searchText          String              @default("") @map("search_text")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  datasetVersion DatasetVersion @relation(fields: [datasetVersionId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Restrict)

  @@id([datasetVersionId, sequence])
  @@index([datasetVersionId, status, sequence])
  @@map("dataset_records")
}

model MappingProfile {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String               @db.VarChar(200)
  description     String               @default("") @db.VarChar(2000)
  status          MappingProfileStatus @default(ACTIVE)
  /// The latest revision; every definition change creates a new MappingProfileRevision.
  currentRevision Int                  @default(1) @map("current_revision")
  dataSchemaHash  String               @map("data_schema_hash") @db.Char(64)
  headerSignature String               @map("header_signature") @db.Char(64)
  sourceFormat    DataSourceFormat?    @map("source_format")
  definition      Json
  createdById     String               @map("created_by_id") @db.Uuid
  updatedById     String               @map("updated_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User                     @relation("MappingProfileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                     @relation("MappingProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  revisions    MappingProfileRevision[]
  imports      DataImport[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status, dataSchemaHash])
  @@map("mapping_profiles")
}

/// Immutable history of a mapping profile's definitions.
model MappingProfileRevision {
  profileId       String   @map("profile_id") @db.Uuid
  revision        Int
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(200)
  definition      Json
  dataSchemaHash  String   @map("data_schema_hash") @db.Char(64)
  headerSignature String   @map("header_signature") @db.Char(64)
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profile      MappingProfile @relation(fields: [profileId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User           @relation("MappingProfileRevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([profileId, revision])
  @@map("mapping_profile_revisions")
}

// ------------------------------------------------------------------------------------------------
// Audit
// ------------------------------------------------------------------------------------------------

/// Append-only audit trail (UPDATE/DELETE blocked by trigger).
model AuditEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(64)
  resourceType   String   @map("resource_type") @db.VarChar(64)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  requestId      String?  @map("request_id") @db.VarChar(100)
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

// ------------------------------------------------------------------------------------------------
// Production (Phase 5): jobs, instances, sequences, manifests
// ------------------------------------------------------------------------------------------------

enum ProductionJobStatus {
  DRAFT
  QUEUED
  EXPANDING
  VALIDATING
  READY
  READY_WITH_WARNINGS
  HAS_ERRORS
  RELEASED
  READY_FOR_RENDERING
  FAILED
  CANCELLED

  @@map("production_job_status")
}

enum ProductionInstanceStatus {
  VALID
  WARNING
  ERROR

  @@map("production_instance_status")
}

enum ProductionMode {
  PRODUCTION
  NON_PRODUCTION

  @@map("production_mode")
}

enum SequenceStatus {
  ACTIVE
  ARCHIVED

  @@map("sequence_status")
}

/// Phase 5 supports NEVER only: a sequence that never restarts cannot produce duplicate serials.
enum SequenceResetPolicy {
  NEVER

  @@map("sequence_reset_policy")
}

enum ProductionArtifactKind {
  MANIFEST

  @@map("production_artifact_kind")
}

/// A server-side serial number source. Numbers are handed out in reserved ranges, never computed
/// from `max(serial) + 1`, and `nextValue` only ever moves forward.
model Sequence {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String              @db.VarChar(200)
  /// Stable short code used in manifests and hashes (e.g. "YT-HANGTAG").
  code           String              @db.VarChar(64)
  description    String              @default("") @db.VarChar(2000)
  prefix         String              @default("") @db.VarChar(16)
  suffix         String              @default("") @db.VarChar(16)
  padding        Int                 @default(0)
  /// The next number to hand out; moved forward inside the reservation transaction.
  nextValue      BigInt              @default(1) @map("next_value")
  resetPolicy    SequenceResetPolicy @default(NEVER) @map("reset_policy")
  status         SequenceStatus      @default(ACTIVE)
  /// Optimistic-concurrency counter for edits.
  revision       Int                 @default(1)
  createdById    String              @map("created_by_id") @db.Uuid
  updatedById    String              @map("updated_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User                  @relation("SequenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User                  @relation("SequenceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reservations SequenceReservation[]
  jobs         ProductionJob[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
  @@map("sequences")
}

/// An atomic range of serial numbers that belongs to one production job for good. Ranges are never
/// released or reused, even if the job later fails: a gap is always safer than a duplicate serial.
model SequenceReservation {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sequenceId      String   @map("sequence_id") @db.Uuid
  productionJobId String   @unique @map("production_job_id") @db.Uuid
  startValue      BigInt   @map("start_value")
  endValue        BigInt   @map("end_value")
  valueCount      Int      @map("value_count")
  reservedById    String   @map("reserved_by_id") @db.Uuid
  reservedAt      DateTime @default(now()) @map("reserved_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sequence      Sequence      @relation(fields: [sequenceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  productionJob ProductionJob @relation(fields: [productionJobId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  reservedBy    User          @relation("SequenceReservationReservedBy", fields: [reservedById], references: [id], onDelete: Restrict)

  @@unique([id, organizationId])
  /// One reservation per job, within its own organization (the relation is one-to-one).
  @@unique([productionJobId, organizationId])
  @@index([sequenceId, startValue])
  @@map("sequence_reservations")
}

/// Per-organization, per-day counter behind the human-readable job number (PJ-20260916-000123).
model ProductionJobCounter {
  organizationId String   @map("organization_id") @db.Uuid
  /// UTC calendar day, "YYYY-MM-DD".
  day            String   @db.Char(10)
  nextValue      Int      @default(1) @map("next_value")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, day])
  @@map("production_job_counters")
}

/// One batch of tags: an approved template version and a finalized dataset version, expanded into
/// an exact, ordered, hashed set of production instances.
model ProductionJob {
  id                       String              @id @default(uuid(7)) @db.Uuid
  organizationId           String              @map("organization_id") @db.Uuid
  jobNumber                String              @map("job_number") @db.VarChar(32)
  name                     String              @db.VarChar(200)
  description              String              @default("") @db.VarChar(2000)
  customerId               String?             @map("customer_id") @db.Uuid
  brandId                  String?             @map("brand_id") @db.Uuid
  /// Exact artwork: the approved version, its document hash and the schema it was stored with.
  templateId               String              @map("template_id") @db.Uuid
  templateVersionId        String              @map("template_version_id") @db.Uuid
  templateVersionHash      String              @map("template_version_hash") @db.Char(64)
  templateSchemaVersion    Int                 @map("template_schema_version")
  dataSchemaHash           String              @map("data_schema_hash") @db.Char(64)
  /// Exact data: one finalized dataset version and its hash.
  datasetId                String              @map("dataset_id") @db.Uuid
  datasetVersionId         String              @map("dataset_version_id") @db.Uuid
  datasetHash              String              @map("dataset_hash") @db.Char(64)
  status                   ProductionJobStatus @default(DRAFT)
  productionMode           ProductionMode      @default(PRODUCTION) @map("production_mode")
  /// Quantity mode, serial configuration, record selection, warning policy (production-core).
  configuration            Json
  /// Hash of the selected record sequences; null when the job produces every record.
  recordSelectionHash      String?             @map("record_selection_hash") @db.Char(64)
  /// Sequence the serial numbers come from; kept as a column so the database enforces the tenant.
  sequenceId               String?             @map("sequence_id") @db.Uuid
  /// Optimistic-concurrency counter for user actions (configure, expand, release, cancel).
  revision                 Int                 @default(1)
  /// Incremented whenever expansion or release is (re)requested; jobs carry the run they belong to.
  expansionRun             Int                 @default(0) @map("expansion_run")
  releaseRun               Int                 @default(0) @map("release_run")
  recordCount              Int                 @default(0) @map("record_count")
  instanceCount            Int                 @default(0) @map("instance_count")
  validCount               Int                 @default(0) @map("valid_count")
  warningCount             Int                 @default(0) @map("warning_count")
  errorCount               Int                 @default(0) @map("error_count")
  /// Instances whose dataset record already carried warnings when it was imported.
  sourceWarningCount       Int                 @default(0) @map("source_warning_count")
  /// SHA-256 over the ordered instance hashes; set when the release run completed.
  instancesDigest          String?             @map("instances_digest") @db.Char(64)
  productionJobHash        String?             @map("production_job_hash") @db.Char(64)
  /// Resolver, expression engine and production contract versions used for this job.
  versions                 Json                @default("{}")
  /// Issue counts per code and per field, for the review screen.
  validationSummary        Json                @default("{}") @map("validation_summary")
  progressPhase            String?             @map("progress_phase") @db.VarChar(32)
  progressProcessed        Int                 @default(0) @map("progress_processed")
  progressTotal            Int?                @map("progress_total")
  progressUpdatedAt        DateTime?           @map("progress_updated_at") @db.Timestamptz(3)
  failure                  Json?
  /// Job metrics (durations, throughput, peak memory).
  metrics                  Json                @default("{}")
  warningsAcknowledgedById String?             @map("warnings_acknowledged_by_id") @db.Uuid
  warningsAcknowledgedAt   DateTime?           @map("warnings_acknowledged_at") @db.Timestamptz(3)
  createdById              String              @map("created_by_id") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  expandedAt               DateTime?           @map("expanded_at") @db.Timestamptz(3)
  releasedById             String?             @map("released_by_id") @db.Uuid
  releasedAt               DateTime?           @map("released_at") @db.Timestamptz(3)
  readyForRenderingAt      DateTime?           @map("ready_for_rendering_at") @db.Timestamptz(3)
  cancelledById            String?             @map("cancelled_by_id") @db.Uuid
  cancelledAt              DateTime?           @map("cancelled_at") @db.Timestamptz(3)

  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customer               Customer?            @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  /// Composite FK: the brand must belong to this job's customer, in this organization.
  brand                  Brand?               @relation(fields: [brandId, customerId, organizationId], references: [id, customerId, organizationId], onDelete: Restrict, onUpdate: Restrict)
  template               Template             @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  templateVersion        TemplateVersion      @relation(fields: [templateVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  dataset                Dataset              @relation(fields: [datasetId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  datasetVersion         DatasetVersion       @relation(fields: [datasetVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  sequence               Sequence?            @relation(fields: [sequenceId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy              User                 @relation("ProductionJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy             User?                @relation("ProductionJobReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  cancelledBy            User?                @relation("ProductionJobCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  warningsAcknowledgedBy User?                @relation("ProductionJobWarningsAcknowledgedBy", fields: [warningsAcknowledgedById], references: [id], onDelete: Restrict)
  instances              ProductionInstance[]
  artifacts              ProductionArtifact[]
  events                 ProductionJobEvent[]
  reservation            SequenceReservation?

  @@unique([organizationId, jobNumber])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([datasetVersionId])
  @@index([templateVersionId])
  @@map("production_jobs")
}

/// One physical tag. The data itself is not copied: the instance points at its dataset record,
/// which is immutable, and adds only what makes this tag different from the other copies.
model ProductionInstance {
  productionJobId       String                   @map("production_job_id") @db.Uuid
  /// 1-based position in the job; the order tags will be produced in.
  sequence              Int
  organizationId        String                   @map("organization_id") @db.Uuid
  datasetRecordSequence Int                      @map("dataset_record_sequence")
  sourceRowNumber       Int                      @map("source_row_number")
  copyIndex             Int                      @map("copy_index")
  copies                Int
  /// Position inside the reserved serial range; null when the job uses no serial numbers.
  serialOffset          Int?                     @map("serial_offset")
  serialValue           String?                  @map("serial_value") @db.VarChar(64)
  status                ProductionInstanceStatus
  errorCount            Int                      @default(0) @map("error_count")
  warningCount          Int                      @default(0) @map("warning_count")
  /// Warnings the dataset record already carried when it was imported.
  sourceWarningCount    Int                      @default(0) @map("source_warning_count")
  issues                Json                     @default("[]")
  /// Phase 3 hash of artwork plus data; null for instances with errors.
  resolvedInputHash     String?                  @map("resolved_input_hash") @db.Char(64)
  /// Artwork plus data plus production context; written when the job is released.
  instanceHash          String?                  @map("instance_hash") @db.Char(64)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionJob ProductionJob @relation(fields: [productionJobId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Restrict)

  @@id([productionJobId, sequence])
  @@index([productionJobId, status, sequence])
  /// Serial lookups are prefix searches ("YT-0100…"), which need the pattern operator class.
  @@index([productionJobId, serialValue(ops: raw("varchar_pattern_ops"))], map: "production_instances_serial_idx")
  @@index([productionJobId, datasetRecordSequence, copyIndex])
  @@map("production_instances")
}

/// A file produced for a released job. Phase 5 writes exactly one: the production manifest.
model ProductionArtifact {
  id              String                 @id @default(uuid(7)) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  productionJobId String                 @map("production_job_id") @db.Uuid
  kind            ProductionArtifactKind
  storageKey      String                 @map("storage_key") @db.VarChar(512)
  contentType     String                 @map("content_type") @db.VarChar(100)
  sizeBytes       Int                    @map("size_bytes")
  checksumSha256  String                 @map("checksum_sha256") @db.Char(64)
  createdById     String                 @map("created_by_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionJob ProductionJob @relation(fields: [productionJobId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User          @relation("ProductionArtifactCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// One manifest per job: a retry rewrites the same row instead of creating a second manifest.
  @@unique([productionJobId, kind])
  @@unique([id, organizationId])
  @@map("production_artifacts")
}

/// The job's own history (created, configured, validated, released, …). Kept next to the job so the
/// global audit trail is not flooded with per-job detail.
model ProductionJobEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  productionJobId String   @map("production_job_id") @db.Uuid
  type            String   @db.VarChar(64)
  message         String   @default("") @db.VarChar(500)
  metadata        Json     @default("{}")
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productionJob ProductionJob @relation(fields: [productionJobId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Restrict)
  createdBy     User?         @relation("ProductionJobEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productionJobId, createdAt])
  @@map("production_job_events")
}
