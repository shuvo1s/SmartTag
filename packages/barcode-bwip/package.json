{
  "name": "@smarttag/barcode-bwip",
  "version": "0.1.0",
  "private": true,
  "description": "BarcodeEncoder adapter backed by bwip-js. The only package that depends on a barcode library.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@smarttag/barcode-core": "0.1.0",
    "@smarttag/document-schema": "0.1.0",
    "bwip-js": "4.11.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  }
}
