{
  "name": "@smarttag/tabular-sources",
  "version": "0.1.0",
  "private": true,
  "description": "Untrusted tabular file readers behind one TabularSourceParser contract: CSV (csv-parse, streaming) and XLSX (yauzl + sax, bounded, no formula evaluation), file format detection and inspection. Node.js only.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@smarttag/import-core": "0.1.0",
    "csv-parse": "7.0.2",
    "fflate": "^0.8.3",
    "sax": "1.6.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/sax": "^1.2.7",
    "@types/yauzl": "^3.4.0"
  }
}
