{
  "name": "@smarttag/data-core",
  "version": "0.1.0",
  "private": true,
  "description": "Variable data domain: data-record validation and normalization, binding resolution, resolved-artwork checks, field usages and resolved-input identity. Framework- and canvas-independent.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@smarttag/barcode-core": "0.1.0",
    "@smarttag/document-schema": "0.1.0",
    "@smarttag/document-utils": "0.1.0",
    "@smarttag/expression-core": "0.1.0"
  },
  "devDependencies": {
    "@smarttag/rendering-core": "0.1.0"
  }
}
