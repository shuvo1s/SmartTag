# SmartTag API — example environment. Copy to apps/api/.env and adjust.
# Never commit real credentials. Every variable is validated at startup (src/config/env.schema.ts).

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP ---------------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Browser origins allowed to send cookie-authenticated, state-changing requests (CSRF defence).
API_ALLOWED_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy (e.g. the web app's /api rewrite).
API_TRUST_PROXY=true

# --- DATABASE (PostgreSQL) ----------------------------------------------------------------------
# docker compose or `npm run pg:local -- init` both expose 127.0.0.1:55432.
DATABASE_URL=postgresql://smarttag:smarttag@127.0.0.1:55432/smarttag_dev
# Used by integration tests only; must point at a disposable database.
TEST_DATABASE_URL=postgresql://smarttag:smarttag@127.0.0.1:55432/smarttag_test

# --- REDIS (BullMQ) ------------------------------------------------------------------------------
# Required for CSV/XLSX data imports (they run in apps/worker). Without it the API still starts, and
# import endpoints answer 503 SERVICE_UNAVAILABLE. `npm run redis:local -- start` or docker compose.
REDIS_URL=redis://127.0.0.1:56379

# --- OBJECT STORAGE -----------------------------------------------------------------------------
# local: files under OBJECT_STORAGE_LOCAL_ROOT.  s3: AWS S3, Cloudflare R2, MinIO or any S3-compatible store.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=../../storage
# OBJECT_STORAGE_DRIVER=s3
# OBJECT_STORAGE_BUCKET=smarttag-assets
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
ASSET_MAX_UPLOAD_BYTES=26214400

# --- DATA IMPORTS (CSV / XLSX) -----------------------------------------------------------------
# The API and the worker must use the same values. Defaults shown; see docs/data-imports.md.
# IMPORT_MAX_FILE_BYTES=52428800
# IMPORT_MAX_ROWS=100000
# IMPORT_MAX_COLUMNS=250
# IMPORT_MAX_SHEETS=50
# IMPORT_MAX_CELL_CHARS=10000
# IMPORT_MAX_HEADER_CHARS=256
# IMPORT_PREVIEW_ROWS=25
# IMPORT_XLSX_MAX_ENTRIES=1000
# IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=536870912
# IMPORT_XLSX_MAX_COMPRESSION_RATIO=200
# IMPORT_XLSX_MAX_SHARED_STRINGS_BYTES=134217728
# IMPORT_VALIDATION_BATCH_SIZE=500
# IMPORT_ABANDONED_AFTER_HOURS=336
# IMPORT_PENDING_UPLOAD_AFTER_MINUTES=60
# IMPORT_STALLED_AFTER_MINUTES=30

# --- AUTH ---------------------------------------------------------------------------------------
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=120
# Must be true in production (enables Secure + __Host- cookie prefix). false for http://localhost.
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Future: Microsoft Entra ID / OIDC single sign-on (not used in Phase 1)
# AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=

# --- DEVELOPMENT SEED ---------------------------------------------------------------------------
# Password assigned to seeded development users. The seed refuses to run when NODE_ENV=production.
SEED_USER_PASSWORD=SmartTag-Dev-2026!
