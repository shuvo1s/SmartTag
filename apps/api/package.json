{
  "name": "@smarttag/api",
  "version": "0.1.0",
  "private": true,
  "description": "SmartTag Platform API (NestJS). Owns business logic, authentication, authorization and persistence.",
  "type": "commonjs",
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@smarttag/config": "0.1.0",
    "@smarttag/data-core": "0.1.0",
    "@smarttag/database": "0.1.0",
    "@smarttag/document-schema": "0.1.0",
    "@smarttag/document-utils": "0.1.0",
    "@smarttag/import-core": "0.1.0",
    "@smarttag/import-processing": "0.1.0",
    "@smarttag/object-storage": "0.1.0",
    "@smarttag/production-core": "0.1.0",
    "@smarttag/production-processing": "0.1.0",
    "@smarttag/shared-types": "0.1.0",
    "@smarttag/tabular-sources": "0.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "image-size": "^2.0.4",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fontkit": "^2.0.9",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "unplugin-swc": "^1.6.0"
  }
}
