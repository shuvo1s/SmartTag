{
  "name": "@smarttag/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SmartTag background worker (BullMQ). Phase 1: queue foundation only; rendering jobs arrive in later phases.",
  "type": "commonjs",
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "pino": "^9.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
