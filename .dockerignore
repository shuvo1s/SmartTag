# What never reaches a Docker build context.
#
# The images install dependencies and build the workspace inside the builder stage, so the context
# carries only manifests, the lockfile and source. Nothing here may exclude Prisma migrations,
# prisma.config.ts, source code or the configuration files the build reads (turbo.json,
# tsconfig.base.json, .npmrc, next.config.ts, postcss.config.mjs).

# --- Dependencies and build output: produced inside the image ------------------------------------
node_modules
**/node_modules
dist
**/dist
.next
**/.next
out
**/out
.turbo
**/.turbo
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts
# Regenerated by `prisma generate` during the build (packages/database/prisma stays in the context).
packages/database/src/generated

# --- Secrets: never in an image layer ------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*

# --- Git history and repository metadata ---------------------------------------------------------
.git
.gitignore
.gitattributes
.github
.editorconfig
.prettierignore
.prettierrc.json
.nvmrc

# --- Local development infrastructure and data ---------------------------------------------------
# .local holds a project-local Node runtime and Redis; storage holds locally uploaded assets;
# infra and docker-compose.yml are the developer's Postgres/Redis/MinIO stack.
.local
storage
infra
docker-compose.yml

# --- Tests, reports and other build-irrelevant output --------------------------------------------
coverage
**/coverage
test-results
**/test-results
playwright-report
**/playwright-report
e2e/.auth
**/*.log
npm-debug.log*

# --- Backups and temporary files -----------------------------------------------------------------
*.bak
**/*.bak
*.orig
**/*.orig
*.tmp
**/*.tmp
tmp
.tmp
backup
backups
*.dump
*.sql.gz
*.tar
*.tgz
*.zip

# --- Editor and OS files -------------------------------------------------------------------------
.vscode
.idea
.DS_Store
Thumbs.db

# --- Documentation: not needed to build or run ---------------------------------------------------
docs
README.md
